# Copy this file to .env and fill in your values:
#     cp .env.example .env
# .env is gitignored, so your real values stay off GitHub. This template is committed.

# The X32's IP address. Find it on the rack under Setup -> Network,
# or in Mixing Station's connection settings.
X32_IP=

# OSC port. The X32 always uses 10023, so only change this if you know you need to.
X32_PORT=10023
